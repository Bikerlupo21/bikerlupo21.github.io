---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VideoYouTube from '../../components/VideoYouTube.astro';
import Pezzi from '../../components/Pezzi.astro';
import BrandCitati from '../../components/BrandCitati.astro';
import { articoli, RUBRICHE, fmtData, minLettura } from '../../lib/dati';

export async function getStaticPaths() {
  const tutti = await articoli();
  return tutti.map((a) => ({ params: { id: a.id }, props: { a, correlati: tutti.filter((x) => x.id !== a.id).slice(0, 3) } }));
}
const { a, correlati } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const rubricaHref = `/${d.rubrica}/`;
---
<Base titolo={d.titolo} descrizione={d.descrizione} attivo={d.rubrica} immagine={d.copertina}>
  <div class="wrap" style="padding-top: 40px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 32px">
    <nav aria-label="Percorso" class="muted"><a href="/">Home</a> / <a href={rubricaHref}>{RUBRICHE[d.rubrica]}</a> / {d.titolo}</nav>
    <header style="display: flex; flex-direction: column; gap: 18px; max-width: 900px">
      <span class="tag">{RUBRICHE[d.rubrica]}</span>
      <h1 style="font-size: clamp(36px, 5.5vw, 56px)">{d.titolo}</h1>
      <p style="margin: 0; font-size: 20px; line-height: 1.6; color: #444">{d.descrizione}</p>
      <p class="muted">Gabriele · Bikerlupo — <time datetime={d.data.toISOString()}>{fmtData(d.data)}</time> · {minLettura(a.body)} min di lettura</p>
    </header>

    {d.youtube
      ? <VideoYouTube id={d.youtube} titolo={d.titolo} capitoli={d.capitoli} />
      : d.copertina && <img src={d.copertina} alt="" style="border: 3px solid var(--nero); border-radius: 10px; width: 100%; max-height: 560px; object-fit: cover" />}

    <div class="colonne">
      <article class="principale prosa">
        {d.rubrica === 'provato-da-me' && (d.voto || d.pro.length > 0) && (
          <div class="box" style="background: var(--celeste-velo)">
            {d.voto && <p style="font-weight: 900; font-size: 22px; text-transform: uppercase">Il mio voto: {d.voto}</p>}
            <div style="display: flex; flex-wrap: wrap; gap: 24px">
              {d.pro.length > 0 && <div style="flex: 1 1 200px"><h2 style="font-size: 16px; margin: 0 0 6px">Pro</h2><ul style="margin: 0; padding-left: 20px">{d.pro.map((p) => <li>{p}</li>)}</ul></div>}
              {d.contro.length > 0 && <div style="flex: 1 1 200px"><h2 style="font-size: 16px; margin: 0 0 6px">Contro</h2><ul style="margin: 0; padding-left: 20px">{d.contro.map((p) => <li>{p}</li>)}</ul></div>}
            </div>
          </div>
        )}
        <Content />
        <Pezzi pezzi={d.pezzi} totale={d.totale} />
        {d.youtube && (
          <div class="scuro" style="border-radius: 12px; padding: 28px; display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between">
            <p style="margin: 0; font-size: 18px; font-weight: 700; flex: 1 1 280px">Ti è stato utile? Dimmi la tua sotto al video: rispondo a tutti.</p>
            <a class="btn primario" href={`https://www.youtube.com/watch?v=${d.youtube}`}>Vai al video</a>
          </div>
        )}
      </article>
      <aside class="laterale">
        <BrandCitati brand={d.brand} />
        {correlati.length > 0 && (
          <div class="box">
            <h2 style="font-size: 16px">Leggi anche</h2>
            {correlati.map((c) => <a href={`/articoli/${c.id}/`} style="font-weight: 800; line-height: 1.4; min-height: 44px; display: block">{c.data.titolo} →</a>)}
          </div>
        )}
      </aside>
    </div>
  </div>
</Base>
