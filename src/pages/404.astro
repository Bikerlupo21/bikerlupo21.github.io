---
import Base from '../layouts/Base.astro';
---
<Base titolo="Pagina non trovata">
  <div class="wrap" style="padding-top: 80px; padding-bottom: 120px; display: flex; flex-direction: column; gap: 22px; align-items: flex-start">
    <h1 style="font-size: clamp(40px, 7vw, 72px)">Strada <span class="hi">chiusa</span></h1>
    <p style="margin: 0; font-size: 18px; line-height: 1.6">Questa pagina non esiste o è stata spostata.</p>
    <span class="hand" style="font-size: 28px">torniamo indietro e prendiamo un'altra curva</span>
    <a class="btn primario" href="/">Torna alla home</a>
  </div>
</Base>
